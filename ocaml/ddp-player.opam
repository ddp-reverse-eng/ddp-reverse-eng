opam-version: "2.0"
synopsis: "Console player for DDP 2.00 audio CD masters"
description:
  "Plays a DDP fileset through libao, with the track list, CD-Text, position and play/pause, track skip and seek controls."
maintainer: [
  "DDP Reverse Engineer <ddp-reverse-eng@users.noreply.github.com>"
]
authors: ["DDP Reverse Engineer"]
license: "MIT"
homepage: "https://github.com/ddp-reverse-eng/ddp-reverse-eng"
bug-reports: "https://github.com/ddp-reverse-eng/ddp-reverse-eng/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "ddp" {= version}
  "ao"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ddp-reverse-eng/ddp-reverse-eng.git"
