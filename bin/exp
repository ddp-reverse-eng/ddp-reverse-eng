#!/bin/sh
# Usage: bin/exp [--inputs] exp/NNN-name
# The directory holds input.cue and run.args: "FRAMES [cue2ddp options...]",
# and optionally audio.variant naming a bin/mkwav-variant variant, or
# audio.split listing pieces of one pattern for multi-FILE cue sheets.
# Generates the audio the cue references (audio.wav, raw audio.bin, big-endian
# audio.mot), then rebuilds out/ with cue2ddp and logs its output.
# With --inputs, only generates the audio.
set -e
inputs_only=false
[ "$1" = --inputs ] && { inputs_only=true; shift; }
dir=$1
root=$(cd "$(dirname "$0")/.." && pwd)
set -- $(cat "$dir/run.args")
frames=$1; shift
if [ -f "$dir/audio.variant" ]; then
  "$root/bin/mkwav-variant" "$(cat "$dir/audio.variant")" "$dir/audio.wav" "$frames"
else
  "$root/bin/mkwav" "$dir/audio.wav" "$frames"
fi
# audio.split: one "NAME FROM FRAMES" line per piece of a longer pattern
if [ -f "$dir/audio.split" ]; then
  while read -r name from count; do
    "$root/bin/mkwav" "$dir/$name" "$count" "from=$from"
  done < "$dir/audio.split"
fi
for raw in bin mot; do
  if grep -q "audio.$raw" "$dir/input.cue"; then
    "$root/bin/mkwav" "$dir/audio.$raw" "$frames"
    # audio.trailing: extra bytes appended to the raw file, e.g. half a sample frame
    [ ! -f "$dir/audio.trailing" ] || cat "$dir/audio.trailing" >> "$dir/audio.$raw"
  fi
done
$inputs_only && exit 0
rm -rf "$dir/out" && mkdir "$dir/out"
cd "$dir" && "$root/bin/ddp" cue2ddp "$@" input.cue out > cue2ddp.log
