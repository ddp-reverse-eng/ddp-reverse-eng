#!/bin/sh
# Usage: bin/compare [exp/NNN-name...]
# Runs the OCaml cue2ddp on each experiment and requires byte-identical
# output, or a rejection where cue2ddp rejected the input (REJECTED).
# EXPECT names another experiment whose output ours must match instead: our
# writer accepts some inputs cue2ddp refuses, e.g. losslessly converted WAV.
# ACCEPT: ours accepts what cue2ddp refuses, with no reference to compare.
# REFUSE: ours refuses what cue2ddp accepts, because cue2ddp's output is broken.
# IMAGE.DAT is not committed; the committed CHECKSUM.MD5 still pins it.
# Every fileset the writer produces must also pass ddpread without errors.
# CUE2DDP and DDPREAD name prebuilt executables (dune test sets them); otherwise they are built here.
root=$(cd "$(dirname "$0")/.." && pwd)
if [ -n "$CUE2DDP" ]; then
  tool=$(realpath "$CUE2DDP") reader=$(realpath "$DDPREAD")
else
  (cd "$root/ocaml" && dune build 2>&1) || exit 1
  tool=$root/ocaml/_build/default/bin/cue2ddp.exe
  reader=$root/ocaml/_build/default/bin/ddpread.exe
fi
[ $# -gt 0 ] || set -- "$root"/exp/*/
failed=0 files=0 rejects=0

fail() { echo "FAIL $name: $*"; failed=$((failed + 1)); }

# Compares our output in $ours with the reference output directory $1.
same_as() {
  for f in "$1"/*; do
    files=$((files + 1))
    cmp -s "$f" "$ours/$(basename "$f")" || fail "$(basename "$f") differs from $1"
  done
  extra=$(cd "$ours" && ls | while read f; do [ "$f" = IMAGE.DAT ] || [ -e "$1/$f" ] || echo "$f"; done)
  [ -z "$extra" ] || fail "extra files $extra"
}

for dir in "$@"; do
  dir=$(cd "$dir" && pwd); name=$(basename "$dir")
  set -- $(cat "$dir/run.args")
  shift
  [ -f "$dir/audio.wav" ] || "$root/bin/exp" --inputs "$dir"
  ours=$(mktemp -d "$root/.run.XXXXXX")
  if (cd "$dir" && "$tool" "$@" input.cue "$ours" > "$ours.log" 2>&1); then
    "$reader" "$ours" 2>&1 >/dev/null | grep '^error:' | while read -r issue; do echo "FAIL $name: ddpread: $issue"; done | tee "$ours.read"
    [ ! -s "$ours.read" ] || failed=$((failed + 1))
    if [ -f "$dir/EXPECT" ]; then same_as "$root/exp/$(cat "$dir/EXPECT")/out"
    elif [ -f "$dir/ACCEPT" ]; then files=$((files + 1))
    elif [ -f "$dir/REFUSE" ]; then fail "accepted, should refuse: $(cat "$dir/REFUSE")"
    elif [ -f "$dir/REJECTED" ]; then fail "accepted, cue2ddp rejects: $(cat "$dir/REJECTED")"
    else same_as "$dir/out"; fi
  elif [ -f "$dir/REFUSE" ] || { [ -f "$dir/REJECTED" ] && [ ! -f "$dir/EXPECT" ] && [ ! -f "$dir/ACCEPT" ]; }; then
    rejects=$((rejects + 1))
  else
    fail "$(cat "$ours.log")"
  fi
  rm -rf "$ours" "$ours.log" "$ours.read"
done
echo "compared $files files, checked $rejects rejections, $failed failures"
[ "$failed" -eq 0 ] && [ $((files + rejects)) -gt 0 ]
