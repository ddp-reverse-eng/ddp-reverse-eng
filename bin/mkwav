#!/usr/bin/env python3
"""Usage: mkwav OUT.wav FRAMES [silence]

Writes 44.1 kHz 16-bit stereo audio, FRAMES CD frames (588 samples) long.
Default content is a position pattern: stereo sample i has L = i & 0xffff,
R = i >> 16, so any byte in an image can be traced back to its source sample.
"""
import struct, sys, wave

out, frames = sys.argv[1], int(sys.argv[2])
silence = sys.argv[3:] == ["silence"]
n = frames * 588
with wave.open(out, "wb") as w:
    w.setnchannels(2)
    w.setsampwidth(2)
    w.setframerate(44100)
    if silence:
        w.writeframes(bytes(n * 4))
    else:
        w.writeframes(b"".join(struct.pack("<HH", i & 0xFFFF, i >> 16) for i in range(n)))
