#!/usr/bin/env python3
"""Usage: mkwav OUT.{wav,bin,mot} FRAMES[+SAMPLES] [silence]

Writes 44.1 kHz 16-bit stereo audio, FRAMES CD frames (588 samples) plus
SAMPLES stereo samples long: a WAVE file, or headerless little-endian (.bin)
or big-endian (.mot) samples as cue sheet BINARY and MOTOROLA files expect.
Default content is a position pattern: stereo sample i has L = i & 0xffff,
R = i >> 16, so any byte in an image can be traced back to its source sample.
"""
import array, sys, wave

out, length = sys.argv[1], sys.argv[2].split("+")
silence = sys.argv[3:] == ["silence"]
n = int(length[0]) * 588 + (int(length[1]) if len(length) > 1 else 0)

def blocks(size=1 << 20):
    for start in range(0, n, size):
        count = min(size, n - start)
        if silence:
            yield bytes(count * 4)
        else:
            # One little-endian 32-bit word per stereo sample puts i & 0xffff in L and i >> 16 in R.
            block = array.array("I", range(start, start + count))
            if out.endswith(".mot"):
                block = array.array("H", block.tobytes())
                block.byteswap()
            yield block.tobytes()


if out.endswith(".wav"):
    with wave.open(out, "wb") as w:
        w.setnchannels(2)
        w.setsampwidth(2)
        w.setframerate(44100)
        for block in blocks():
            w.writeframes(block)
else:
    with open(out, "wb") as f:
        for block in blocks():
            f.write(block)
