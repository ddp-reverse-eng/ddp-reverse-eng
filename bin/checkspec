#!/usr/bin/env python3
"""Checks that the spec field tables tile each record exactly and match real cue2ddp output."""
import os, re
os.chdir(os.path.join(os.path.dirname(__file__), '..'))
spec=open('spec/ddp2.md').read()
def table(sec):
    body=spec.split('## '+sec)[1].split('\n## ')[0]
    return [(int(m[1]),int(m[2]),m[3]) for m in re.finditer(r'^\| (\d+) \| (\d+) \| ([\w-]+) \|',body,re.M)]
for sec,size,f,rec,checks in [('3. DDPID: identifier',128,'exp/007-master-id/out/DDPID',0,{'DDPID':'DDP 2.00','MID':'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijkl','TYPE':'CD'}),
    ('4. DDPMS: map stream',128,'exp/011-cdtext-cue/out/DDPMS',2,{'DST':'D0','DSL':'    1650','CDM':'DA','SSM':'7','SCR':'1','PRE2':' 150','SIZ':' 17','DSI':'IMAGE.DAT        '}),
    ('5. PQ descriptor',64,'exp/005-isrc-upc/out/SD',0,{'SPV':'VVVS','Tk':'00','A-Time':'  000000','C1':'01','UPC':'0123456789012'})]:
    t=table(sec); off=0
    for o,l,n in t: assert o==off,(sec,n,o,off); off+=l
    assert off==size,(sec,off)
    d=open(f,'rb').read()[rec*size:(rec+1)*size].decode()
    for o,l,n in t:
        if n in checks: assert d[o:o+l]==checks[n],(sec,n,d[o:o+l])
    print(sec,'ok',len(t),'fields')
